ARG NODE_IMAGE=docker.io/library/node:24-alpine
FROM ${NODE_IMAGE}

ENV NODE_ENV=production
WORKDIR /app
# No dependencies (D15). The story arrives without the break-glass value
# (scripts/app-build.sh writes config/story.json through publicStory).
COPY package.json server.js ./
COPY lib ./lib
COPY config ./config

# uid 1000, gid 1000: reads the mounted tokens and the audit logs (0640).
USER 1000:1000
EXPOSE 3000
HEALTHCHECK --interval=10s --timeout=4s --retries=6 --start-period=10s \
  CMD node -e "fetch('http://127.0.0.1:3000/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "server.js"]
